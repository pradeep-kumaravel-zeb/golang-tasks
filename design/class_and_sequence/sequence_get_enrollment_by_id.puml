@startuml GET_Enrollment_By_ID_Sequence
title Sequence Diagram - GET /enrollments/{id} (Get Enrollment By ID)

participant "Client" as Client
participant "pkg/server/server.go" as Server
participant "internal/handlers/handler.go" as Handler
participant "internal/service/service.go" as Service
participant "internal/repository/repository.go" as Repository
participant "Database" as DB

activate Client
Client -> Server : HTTP GET /enrollments/{id}
activate Server

group Constructor Initialization Chain
    Server -> Server : Building dbURL using config.BuildDBUrl(*creds) and establishing DB connection via database.EstablishPostgresConnection(dbURL)
    Server -> Repository : calling the NewRepository(db *gorm.DB) — initializing repository struct with db dependency
    activate Repository
    Repository -> Repository : the NewRepository() is getting triggered with the following parameters with type: db *gorm.DB — returns &repository{db: db} implementing Repository interface
    Repository --> Server : Returning Repository interface instance
    deactivate Repository
    Server -> Service : calling the NewService(repo repository.Repository) — initializing service struct with repo dependency
    activate Service
    Service -> Service : the NewService() is getting triggered with the following parameters with type: repo repository.Repository — returns &service{repo: repo} implementing Service interface
    Service --> Server : Returning Service interface instance
    deactivate Service
    Server -> Handler : calling the NewHandler(service service.Service) — initializing handler struct with service dependency
    activate Handler
    Handler -> Handler : the NewHandler() is getting triggered with the following parameters with type: service service.Service — returns &handler{service: service} implementing HandlerInterface
    Handler --> Server : Returning HandlerInterface instance
    deactivate Handler
    Server -> Server : Registering route router.HandleFunc("/enrollments/{id}", handler.GetEnrollmentByID).Methods("GET")
end

Server -> Handler : calling the GetEnrollmentByID(w http.ResponseWriter, r *http.Request)
activate Handler
Handler -> Handler : the GetEnrollmentByID() is getting triggered with the following parameters with type: w http.ResponseWriter, r *http.Request

group GetEnrollmentByID(w, r)
    Handler -> Handler : Calling mux.Vars(r) which parses the route template "/enrollments/{id}" and returns map[string]string with the captured path segments
    Handler -> Handler : Extracting vars["id"] into variable id of type string
    Handler -> Service : calling the GetEnrollmentByID(id string)
    activate Service
    Service -> Service : the GetEnrollmentByID() is getting triggered with the following parameters with type: id string

    group GetEnrollmentByID(id)
        Service -> Service : Calling uuid.Parse(id) which validates the id string conforms to UUID format (8-4-4-4-12 hex pattern) and converts it to uuid.UUID type

        alt err != nil (id string is not a valid UUID)
            Service --> Handler : Returning error "invalid enrollment ID"
        end

        Service -> Repository : calling the FetchEnrollmentByID(enrollmentID uuid.UUID)
        activate Repository
        Repository -> Repository : the FetchEnrollmentByID() is getting triggered with the following parameters with type: enrollmentID uuid.UUID

        group FetchEnrollmentByID(enrollmentID)
            Repository -> Repository : Declaring var enrollment models.Enrollment
            Repository -> DB : Executing r.db.Preload("Student").Preload("Course").First(&enrollment, "id = ?", id) — this runs SELECT * FROM enrollments WHERE id = ? LIMIT 1, then GORM runs SELECT * FROM students WHERE id = ? and SELECT * FROM courses WHERE id = ? to populate the associations
            activate DB
            DB --> Repository : Returning enrollment record with populated Student and Course structs, or gorm.ErrRecordNotFound
            deactivate DB

            alt errors.Is(err, gorm.ErrRecordNotFound)
                Repository --> Service : Returning nil and errors.New("enrollment not found")
            else err != nil (other DB error)
                Repository --> Service : Returning nil and database error
            else success
                Repository --> Service : Returning &enrollment *models.Enrollment and nil error
            end
        end
        deactivate Repository

        Service -> Service : Mapping to dto.EnrollmentResponse{ID: enrollment.ID.String(), StudentName: enrollment.Student.Name, StudentEmail: enrollment.Student.Email, CourseName: enrollment.Course.Name, CourseFee: enrollment.Course.Fee, EnrollmentDate: enrollment.EnrollmentDate, FeePaid: enrollment.FeePaid, PaymentStatus: enrollment.PaymentStatus}
        Service --> Handler : Returning *dto.EnrollmentResponse and nil error
    end
    deactivate Service

    alt err.Error() == "enrollment not found"
        Handler --> Client : HTTP 404 with "enrollment not found"
    else other error
        Handler --> Client : HTTP 400 with error message
    else success
        Handler --> Client : HTTP 200 with "Enrollment retrieved successfully" and enrollment data
    end
end

deactivate Handler
deactivate Server
deactivate Client

@enduml
