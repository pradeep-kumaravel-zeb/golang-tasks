@startuml GET_All_Enrollments_Sequence
title Sequence Diagram - GET /enrollments (Get All Enrollments)

participant "Client" as Client
participant "pkg/server/server.go" as Server
participant "internal/handlers/handler.go" as Handler
participant "internal/service/service.go" as Service
participant "internal/repository/repository.go" as Repository
participant "Database" as DB

activate Client
Client -> Server : HTTP GET /enrollments?course_name=&payment_status=&student_name=
activate Server

group Constructor Initialization Chain
    Server -> Server : Building dbURL using config.BuildDBUrl(*creds) and establishing DB connection via database.EstablishPostgresConnection(dbURL)
    Server -> Repository : calling the NewRepository(db *gorm.DB) — initializing repository struct with db dependency
    activate Repository
    Repository -> Repository : the NewRepository() is getting triggered with the following parameters with type: db *gorm.DB — returns &repository{db: db} implementing Repository interface
    Repository --> Server : Returning Repository interface instance
    deactivate Repository
    Server -> Service : calling the NewService(repo repository.Repository) — initializing service struct with repo dependency
    activate Service
    Service -> Service : the NewService() is getting triggered with the following parameters with type: repo repository.Repository — returns &service{repo: repo} implementing Service interface
    Service --> Server : Returning Service interface instance
    deactivate Service
    Server -> Handler : calling the NewHandler(service service.Service) — initializing handler struct with service dependency
    activate Handler
    Handler -> Handler : the NewHandler() is getting triggered with the following parameters with type: service service.Service — returns &handler{service: service} implementing HandlerInterface
    Handler --> Server : Returning HandlerInterface instance
    deactivate Handler
    Server -> Server : Registering route router.HandleFunc("/enrollments", handler.GetAllEnrollments).Methods("GET")
end

Server -> Handler : calling the GetAllEnrollments(w http.ResponseWriter, r *http.Request)
activate Handler
Handler -> Handler : the GetAllEnrollments() is getting triggered with the following parameters with type: w http.ResponseWriter, r *http.Request

group GetAllEnrollments(w, r)
    Handler -> Handler : Extracting query param "course_name" via r.URL.Query().Get("course_name") into courseName string
    Handler -> Handler : Extracting query param "payment_status" via r.URL.Query().Get("payment_status") into paymentStatus string
    Handler -> Handler : Extracting query param "student_name" via r.URL.Query().Get("student_name") into studentName string
    Handler -> Service : calling the GetEnrollments(courseName string, paymentStatus string, studentName string)
    activate Service
    Service -> Service : the GetEnrollments() is getting triggered with the following parameters with type: courseName string, paymentStatus string, studentName string

    group GetEnrollments(courseName, paymentStatus, studentName)
        Service -> Repository : calling the FetchAllEnrollments(courseName string, paymentStatus string, studentName string)
        activate Repository
        Repository -> Repository : the FetchAllEnrollments() is getting triggered with the following parameters with type: courseName string, paymentStatus string, studentName string

        group FetchAllEnrollments(courseName, paymentStatus, studentName)
            Repository -> Repository : Initializing var enrollments []models.Enrollment as empty slice
            Repository -> Repository : Building base query: r.db.Preload("Student").Preload("Course") — this tells GORM to eager load the Student and Course associations via separate SELECT queries after the main query

            alt courseName != ""
                Repository -> Repository : Appending JOIN and WHERE: query.Joins("JOIN courses ON courses.id = enrollments.course_id").Where("courses.name ILIKE ?", "%"+courseName+"%") — ILIKE performs case-insensitive pattern matching with wildcard wrapping
            end

            alt paymentStatus != ""
                Repository -> Repository : Appending WHERE: query.Where("enrollments.payment_status = ?", paymentStatus) — exact match filter on payment_status column
            end

            alt studentName != ""
                Repository -> Repository : Appending JOIN and WHERE: query.Joins("JOIN students ON students.id = enrollments.student_id").Where("students.name ILIKE ?", "%"+studentName+"%") — ILIKE performs case-insensitive pattern matching with wildcard wrapping
            end

            Repository -> DB : Executing query.Find(&enrollments) — SELECT * FROM enrollments [JOIN courses ...] [JOIN students ...] [WHERE ...] with GORM then running separate SELECTs for Preloaded Student and Course
            activate DB
            DB --> Repository : Returning matched enrollment records with preloaded Student and Course data
            deactivate DB
        end

        alt err != nil
            Repository --> Service : Returning nil and database error
        else success
            Repository --> Service : Returning []models.Enrollment and nil error
        end
        deactivate Repository

        Service -> Service : Creating responses slice: make([]dto.EnrollmentResponse, len(enrollments))

        loop for i, e := range enrollments
            Service -> Service : Mapping responses[i] = dto.EnrollmentResponse{ID: e.ID.String(), StudentName: e.Student.Name, StudentEmail: e.Student.Email, CourseName: e.Course.Name, CourseFee: e.Course.Fee, EnrollmentDate: e.EnrollmentDate, FeePaid: e.FeePaid, PaymentStatus: e.PaymentStatus}
        end

        Service --> Handler : Returning []dto.EnrollmentResponse and nil error
    end
    deactivate Service

    alt err != nil
        Handler --> Client : HTTP 500 with error message
    else success
        Handler --> Client : HTTP 200 with "Enrollments retrieved successfully" and enrollment list
    end
end

deactivate Handler
deactivate Server
deactivate Client

@enduml
