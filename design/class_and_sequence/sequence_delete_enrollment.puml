@startuml DELETE_Delete_Enrollment_Sequence
title Sequence Diagram - DELETE /enrollments/{id} (Delete Enrollment)

participant "Client" as Client
participant "pkg/server/server.go" as Server
participant "internal/handlers/handler.go" as Handler
participant "internal/service/service.go" as Service
participant "internal/repository/repository.go" as Repository
participant "Database" as DB

activate Client
Client -> Server : HTTP DELETE /enrollments/{id}
activate Server

group Constructor Initialization Chain
    Server -> Repository : calling the NewRepository(db *gorm.DB)
    activate Repository
    Repository -> Repository : returns &repository{db: db} implementing Repository interface
    Repository --> Server : Returning Repository interface instance
    deactivate Repository
    Server -> Service : calling the NewService(repo repository.Repository)
    activate Service
    Service -> Service : returns &service{repo: repo} implementing Service interface
    Service --> Server : Returning Service interface instance
    deactivate Service
    Server -> Handler : calling the NewHandler(service service.Service)
    activate Handler
    Handler -> Handler : returns &handler{service: service} implementing HandlerInterface
    Handler --> Server : Returning HandlerInterface instance
    deactivate Handler
    Server -> Server : Registering router.HandleFunc("/enrollments/{id}", handler.DeleteEnrollment).Methods("DELETE")
end

Server -> Handler : calling the DeleteEnrollment(w, r)
activate Handler
Handler -> Handler : the DeleteEnrollment() is getting triggered with the following parameters with type: w http.ResponseWriter, r *http.Request

group DeleteEnrollment(w, r)
    Handler -> Handler : Calling mux.Vars(r) to extract path variable id string
    Handler -> Service : calling the DeleteEnrollment(id string)
    activate Service
    Service -> Service : the DeleteEnrollment() is getting triggered with the following parameters with type: id string

    group DeleteEnrollment(id)
        Service -> Service : Calling uuid.Parse(id) to validate UUID format (8-4-4-4-12 hex) and convert to uuid.UUID

        alt invalid UUID
            Service --> Handler : Returning error "invalid enrollment ID"
        end

        Service -> Repository : calling the FetchEnrollmentByID(enrollmentID uuid.UUID)
        activate Repository

        group FetchEnrollmentByID(enrollmentID)
            Repository -> Repository : Declaring var enrollment models.Enrollment
            Repository -> DB : Executing r.db.Preload("Student").Preload("Course").First(&enrollment, "id = ?", id) — SELECT * FROM enrollments WHERE id = ? LIMIT 1, then separate SELECTs for Student and Course
            activate DB
            DB --> Repository : Returning enrollment with associations or gorm.ErrRecordNotFound
            deactivate DB

            alt errors.Is(err, gorm.ErrRecordNotFound)
                Repository --> Service : Returning nil and errors.New("enrollment not found")
            else success
                Repository --> Service : Returning &enrollment and nil error
            end
        end
        deactivate Repository

        Service -> Service : Checking enrollment.PaymentStatus == "paid" — business rule: paid enrollments cannot be deleted without a refund first
        alt enrollment.PaymentStatus == "paid"
            Service --> Handler : Returning error "cannot delete enrollment with paid status - refund required first"
        end

        Service -> Service : Checking time.Now().After(enrollment.Course.StartDate) — comparing current timestamp against the course start date to determine if the course has already begun
        alt time.Now().After(enrollment.Course.StartDate) is true
            Service --> Handler : Returning error "cannot delete enrollment - course has already started"
        end

        Service -> Repository : calling the DeleteEnrollment(enrollmentID uuid.UUID)
        activate Repository

        group DeleteEnrollment(enrollmentID)
            Repository -> DB : Executing r.db.Delete(&models.Enrollment{}, "id = ?", id) — DELETE FROM enrollments WHERE id = ?
            activate DB
            DB --> Repository : Success — enrollment record removed from database
            deactivate DB
        end

        Repository --> Service : Returning nil error
        deactivate Repository

        Service --> Handler : Returning nil error
    end
    deactivate Service

    alt err.Error() == "enrollment not found"
        Handler --> Client : HTTP 404 with "enrollment not found"
    else other error (paid status, course started, etc.)
        Handler --> Client : HTTP 400 with error message
    else success
        Handler --> Client : HTTP 200 with "Enrollment deleted successfully"
    end
end

deactivate Handler
deactivate Server
deactivate Client

@enduml
